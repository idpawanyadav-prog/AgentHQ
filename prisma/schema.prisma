generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "sqlite"
 url = env("DATABASE_URL")
}

model Team {
 id String @id @default(cuid())
 name String
 description String?
 status String @default("active") // active | paused | archived
 project Project?
 members Member[]
 tasks Task[]
 activities Activity[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status])
}

model Member {
 id String @id @default(cuid())
 name String
 role String // PM, Dev, QA, Reviewer, Tester
 type String // "human" | "ai"
 avatar String?
 teamId String
 team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
 tasks Task[]
 agents Agent[]
 activities Activity[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([teamId])
 @@index([type])
}

model Agent {
 id String @id @default(cuid())
 name String // "Claude Dev #1"
 type String // "anthropic" | "openai"
 model String // "claude-sonnet-4-5" | "gpt-4o"
 memberId String
 member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
 tasks Task[]
 config String // JSON: { temperature, maxTokens, systemPrompt, tools }
 status String @default("idle") // idle | working | error
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([memberId])
 @@index([status])
}

model Project {
 id String @id @default(cuid())
 name String
 description String?
 status String @default("active")
 progress Int @default(0) // 0-100
 repositoryProvider String?
 repositoryMode String? @default("none")
 repositoryStatus String? @default("unconfigured")
 defaultBranch String? @default("main")
 defaultCodingModelId String?
 validationCommands String?
 teamId String @unique
 team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
 milestones Milestone[]
 sprints Sprint[]
 tasks Task[]
 workspaces Workspace[]
 executionRuns ExecutionRun[]
 executionProposals ExecutionProposal[]
 governance ProjectGovernance?
 issues ProjectIssue[]
 executionState ProjectExecutionState?
 dynamicSquads DynamicSquad[]
 repoUrl String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([teamId])
}

model Milestone {
 id String @id @default(cuid())
 title String
 status String @default("pending") // pending | in_progress | done
 order Int
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([projectId])
}

model Sprint {
 id String @id @default(cuid())
 name String
 goal String?
 status String @default("planned") // planned | active | completed
 startDate DateTime?
 endDate DateTime?
 order Int @default(0)
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 tasks Task[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([projectId])
}

model Task {
 id String @id @default(cuid())
 title String
 description String?
 type String @default("task") // task | bug | feature | chore
 priority String @default("medium") // low | medium | high | critical
 status String @default("backlog") // backlog | ready | in_progress | review | testing | done | blocked
 teamId String
 team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
 projectId String?
 project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
 sprintId String?
 sprint Sprint? @relation(fields: [sprintId], references: [id])
 assigneeId String?
 assignee Member? @relation(fields: [assigneeId], references: [id])
 agentId String?
 agent Agent? @relation(fields: [agentId], references: [id])
 branch String? // git branch for this task
 prNumber Int? // GitHub PR number
 dependencies String // JSON array of task IDs
 storyPoints Int? // 1, 2, 3, 5, 8, 13...
 dueDate DateTime?
 acceptanceCriteria String?
 blocked Boolean @default(false)
 blockedReason String?
 activities Activity[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([teamId])
 @@index([projectId])
 @@index([sprintId])
 @@index([status])
 @@index([priority])
 @@index([agentId])
 @@index([assigneeId])
}

model Activity {
 id String @id @default(cuid())
 type String // "task_assigned" | "commit" | "pr_opened" | "pr_merged" | "agent_started" | "agent_completed" | etc.
 description String
 meta String // JSON string
 teamId String
 team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
 memberId String?
 member Member? @relation(fields: [memberId], references: [id])
 taskId String?
 task Task? @relation(fields: [taskId], references: [id])
 createdAt DateTime @default(now())

 @@index([teamId, createdAt])
 @@index([type])
 @@index([taskId])
}

model Setting {
 id String @id @default(cuid())
 key String @unique
 value String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model Gateway {
 id String @id @default(cuid())
 name String
 provider String // "anthropic" | "openai" | "custom"
 baseUrl String?
 apiKey String // encrypted in production; base64 for now
 model String
 isDefault Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([provider])
 @@index([isDefault])
}

model Job {
 id String @id @default(cuid())
 kind String // "agent_run" | "execution_run"
 status String @default("queued") // queued | running | completed | failed | cancelled
 agentId String
 taskId String?
 teamId String
 payload String // { agentId, taskId, config, model, provider, gatewayId, messages }
 result String?
 error String?
 attempts Int @default(0)
 maxAttempts Int @default(3)
 startedAt DateTime?
 finishedAt DateTime?
 heartbeatAt DateTime?
 cancelled Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([status, createdAt])
 @@index([agentId])
 @@index([taskId])
}

model RoleGroup {
 id String @id @default(cuid())
 name String
 description String?
 color String?
 toolPolicy String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 instructions InstructionFile[]
 assignments AgentRoleAssignment[]
 skills Skill[]

 @@index([name])
}

model InstructionFile {
 id String @id @default(cuid())
 roleGroupId String
 roleGroup RoleGroup @relation(fields: [roleGroupId], references: [id], onDelete: Cascade)
 filename String
 title String?
 content String
 createdAt DateTime @default(now())
 updatedAt DateTime @default(now()) @updatedAt

 @@index([roleGroupId])
}

model AgentRoleAssignment {
 id String @id @default(cuid())
 roleGroupId String
 roleGroup RoleGroup @relation(fields: [roleGroupId], references: [id], onDelete: Cascade)
 agentId String
 agentName String
 agentStatus String @default("active") // active | inactive
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([roleGroupId])
 @@unique([roleGroupId, agentId])
 @@unique([agentId])
}

model Skill {
 id String @id @default(cuid())
 roleGroupId String
 roleGroup RoleGroup @relation(fields: [roleGroupId], references: [id], onDelete: Cascade)
 name String
 level String @default("intermediate") // beginner | intermediate | advanced | expert
 description String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([roleGroupId])
}

model Workspace {
 id String @id @default(cuid())
 projectId String
 executionRunId String?
 path String
 branch String?
 baseCommit String?
 headCommit String?
 status String @default("creating")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 executionRun ExecutionRun? @relation(fields: [executionRunId], references: [id], onDelete: SetNull)

 @@index([projectId])
 @@index([executionRunId])
 @@index([status])
}

model ExecutionRun {
 id String @id @default(cuid())
 projectId String
 taskId String?
 agentId String?
 squadId String?
 jobId String?
 workspaceId String?
 engine String
 configuredModelId String?
 status String @default("queued")
 outcome String?
 failureReason String?
 startedAt DateTime?
 finishedAt DateTime?
 heartbeatAt DateTime?
 exitCode Int?
 timedOut Boolean @default(false)
 inputTokens Int?
 outputTokens Int?
 totalTokens Int?
 costUsd Float?
 resultSummary String?
 changedFiles String?
 artifacts String?
 commands String?
 validation String?
 commitSha String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 workspaces Workspace[]
 checkpoints ExecutionCheckpoint[]
 toolEvents ExecutionToolEvent[]

 @@index([projectId])
 @@index([taskId])
 @@index([agentId])
 @@index([squadId])
 @@index([status])
 @@index([createdAt])
}

model ExecutionProposal {
 id String @id @default(cuid())
 projectId String
 taskId String?
 agentId String?
 squadId String?
 configuredModelId String?
 engine String
 mode String
 prompt String
 branch String?
 commands String?
 implications String?
 blockers String?
 warnings String?
 status String @default("pending")
 createdAt DateTime @default(now())
 approvedAt DateTime?
 appliedAt DateTime?
 rejectedAt DateTime?

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

 @@index([projectId])
 @@index([status])
 @@index([createdAt])
}

model ExecutionToolEvent {
 id String @id @default(cuid())
 executionRunId String
 turn Int
 toolName String
 arguments String?
 resultSummary String?
 status String
 startedAt DateTime
 finishedAt DateTime?

 executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

 @@index([executionRunId])
 @@index([toolName])
 @@index([status])
}

model ExecutionCheckpoint {
 id String @id @default(cuid())
 executionRunId String
 phase String
 gitCommit String?
 taskStatus String?
 agentStatus String?
 metadata String?
 createdAt DateTime @default(now())

 executionRun ExecutionRun @relation(fields: [executionRunId], references: [id], onDelete: Cascade)

 @@index([executionRunId])
 @@index([phase])
}

model DynamicSquad {
 id String @id @default(cuid())
 projectId String
 taskId String?
 name String
 status String @default("active")
 reason String?
 createdAt DateTime @default(now())
 completedAt DateTime?

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
 members SquadMember[]

 @@index([projectId])
 @@index([taskId])
 @@index([status])
}

model SquadMember {
 id String @id @default(cuid())
 squadId String
 agentId String
 role String

 squad DynamicSquad @relation(fields: [squadId], references: [id], onDelete: Cascade)

 @@index([squadId])
 @@index([agentId])
}

model ProjectGovernance {
 id String @id @default(cuid())
 projectId String @unique
 humanDirectives String?
 forbiddenActions String?
 architectureRules String?
 approvalRules String?
 maxDailyTokens Int?
 maxDailyCostUsd Float?
 maxConcurrentRuns Int?
 allowShell Boolean @default(false)
 allowRemotePush Boolean @default(false)
 allowAutoPr Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectIssue {
 id String @id @default(cuid())
 projectId String
 severity String
 title String
 description String?
 status String @default("open")
 source String?
 createdAt DateTime @default(now())
 resolvedAt DateTime?

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

 @@index([projectId])
 @@index([severity])
 @@index([status])
}

model ProjectExecutionState {
 id String @id @default(cuid())
 projectId String @unique
 phase String @default("planning")
 status String @default("active")
 lastRunId String?
 summary String?
 updatedAt DateTime @updatedAt
 createdAt DateTime @default(now())

 project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ===== Memory Foundation =====

model ProjectMemory {
 id String @id @default(cuid())
 projectId String @unique
 mission String?
 productSummary String?
 architecture String?
 techStack String?
 conventions String?
 currentPhase String? // DeliveryPhase enum value
 currentGoal String?
 completedWork String?
 keyDecisions String?
 knownRisks String?
 blockers String?
 nextActions String?
 openQuestions String?
 testStrategy String?
 releaseNotes String?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([projectId])
}

model TaskMemory {
 id String @id @default(cuid())
 taskId String @unique
 projectId String
 objective String?
 context String?
 investigation String?
 implementation String?
 filesTouched String?
 commandsRun String?
 validation String?
 decisions String?
 blockers String?
 remainingWork String?
 nextAction String?
 lastAgentId String?
 lastExecutionId String?
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([projectId])
 @@index([lastAgentId])
}

model AgentMemory {
 id String @id @default(cuid())
 agentId String
 projectId String?
 scope String @default("project") // MemoryScope: global | project | task
 category String // MemoryCategory: technical_pattern | lesson | failure | workflow | domain_knowledge | preference
 title String?
 content String
 importance Int @default(50)
 confidence Float?
 sourceType String?
 sourceId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 lastUsedAt DateTime?

 @@index([agentId])
 @@index([projectId])
 @@index([scope])
 @@index([category])
}

model DecisionRecord {
 id String @id @default(cuid())
 projectId String
 taskId String?
 sprintId String?
 title String
 decision String
 rationale String?
 alternatives String?
 consequences String?
 status String @default("active") // active | superseded
 createdByAgentId String?
 createdAt DateTime @default(now())
 supersededAt DateTime?

 @@index([projectId])
 @@index([taskId])
 @@index([status])
}

model HandoffRecord {
 id String @id @default(cuid())
 projectId String
 taskId String?
 fromAgentId String?
 toAgentId String?
 type String // HandoffType: developer_to_reviewer | reviewer_to_developer | developer_to_qa | qa_to_developer | agent_reassignment | task_pause | task_resume | sprint_handoff
 summary String
 completedWork String?
 remainingWork String?
 importantFiles String?
 decisions String?
 blockers String?
 nextActions String?
 createdAt DateTime @default(now())
 consumedAt DateTime?

 @@index([projectId])
 @@index([taskId])
 @@index([toAgentId])
}

model TaskReview {
 id String @id @default(cuid())
 projectId String
 taskId String @unique
 executionRunId String?
 reviewerAgentId String?
 status String @default("pending") // ReviewStatus: pending | approved | changes_requested
 summary String?
 findings String?
 createdAt DateTime @default(now())
 completedAt DateTime?

 @@index([taskId])
 @@index([status])
}

model SprintSummary {
 id String @id @default(cuid())
 sprintId String @unique
 projectId String
 goal String?
 completed String?
 incomplete String?
 blockers String?
 decisions String?
 lessons String?
 nextSprint String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([projectId])
}

model SprintRetrospective {
 id String @id @default(cuid())
 sprintId String
 projectId String
 wentWell String?
 problems String?
 lessons String?
 actions String?
 createdAt DateTime @default(now())

 @@index([sprintId])
 @@index([projectId])
}
