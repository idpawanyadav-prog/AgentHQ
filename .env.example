# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
JWT_SECRET=your_jwt_secret_here_change_in_production

# AI Provider Keys (backend only, never exposed to frontend)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Gateway Encryption (required in production; development uses .local/gateway.key if unset)
# Exactly 64 hexadecimal characters (32 bytes).
# Generate with: openssl rand -hex 32
GATEWAY_ENCRYPTION_KEY=

# App
NODE_ENV=development

# Setup Token (required for first-time admin setup behind a reverse proxy or in
# cloud deployments where loopback-only setup would fail). Set this to a secure
# random value before first deployment. The first POST /api/auth request must
# include {"token": "<SETUP_TOKEN>", "password": "..."} to create the admin.
SETUP_TOKEN=generate_a_secure_random_token_here
